# Local + frontend en Vercel
CORS_ORIGIN=http://localhost:5173,https://recording-eight.vercel.app

# Opcional: MYSQL_SSL=0 si Clever no usa SSL
# Opcional: AUTO_MIGRATE=1 solo la primera vez para crear tablas
