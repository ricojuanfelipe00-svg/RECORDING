PORT=4000
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Obligatorias en Vercel (copiar de Clever Cloud → MySQL addon)
MYSQL_ADDON_HOST=
MYSQL_ADDON_DB=
MYSQL_ADDON_USER=
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_PASSWORD=

# Local + frontend en Vercel
CORS_ORIGIN=http://localhost:5173,https://recording-eight.vercel.app

# Correo (Gmail: activa contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
MAIL_FROM="Recuérdame <tu_correo@gmail.com>"

# Secreto para el cron de Vercel (/api/cron/notify-emails)
CRON_SECRET=cambia_este_secreto

# Opcional: MYSQL_SSL=0 si Clever no usa SSL
# Opcional: AUTO_MIGRATE=1 solo la primera vez para crear tablas
